<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="4"
    android:rowCount="6"
    android:padding="10dp"
    android:background="#222222">

    <TextView
        android:id="@+id/txtPantalla"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_columnSpan="4"
        android:background="#D3D3D3"
        android:gravity="end|center_vertical"
        android:padding="10dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="30sp"/>

    <!-- FILA 1 -->
    <Button
        android:id="@+id/btn1"
        android:text="1"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn2"
        android:text="2"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn3"
        android:text="3"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnDiv"
        android:text="/"
        app:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"/>

    <!-- FILA 2 -->
    <Button
        android:id="@+id/btn4"
        android:text="4"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn5"
        android:text="5"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn6"
        android:text="6"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnMul"
        android:text="*"
        app:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"/>

    <!-- FILA 3 -->
    <Button
        android:id="@+id/btn7"
        android:text="7"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn8"
        android:text="8"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btn9"
        android:text="9"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnRes"
        android:text="-"
        app:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"/>

    <!-- FILA 4 -->
    <Button
        android:id="@+id/btn0"
        android:text="0"
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnPunto"
        android:text="."
        app:backgroundTint="#4A4A4A"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnIgual"
        android:text="="
        app:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnSum"
        android:text="+"
        app:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"/>

    <!-- FILA 5 -->
    <Button
        android:id="@+id/btnC"
        android:text="C"
        app:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnAC"
        android:text="AC"
        app:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"/>

</GridLayout>